;;; Commentary:

;; The default turn executor (`elark-ai-strategy' is `agent').  The
;; upfront-plan executor (`elark-ai-runner') remains available by setting
;; `elark-ai-strategy' to `plan'.
;;
;; Instead of asking the LLM for a whole plan in advance, the agent runs
;; an iterative ReAct-style loop: each turn it asks the model for ONE
;; action — either a lark-cli command to run, or a final answer — runs
;; the command, feeds the observation back, and repeats until the model
;; emits a final answer (or the step cap is hit).
;;
;; Because the model writes any generated content directly into a
;; command's arguments (no `$step-N' indirection), a "produce content →
;; write content" task is handled naturally within the loop: the model
;; generates the document body in the same action that creates the doc.
;;
;; The loop is a callback recursion (the LLM dispatch is async), mirroring
;; the runner's structure.  Like the runner, this module forward-declares
;; the UI-wiring helpers that live in `elark-ai.el' so there is no
;; load-time dependency back on the orchestrator.
;;
;; Transcript of (action . observation) pairs lives on the session's
;; `agent-steps' slot so it survives across the async hops and is
;; inspectable / abortable.

;;; Code:

(require 'elark-ai-protocol)   ; session struct, extract-json, build-user-message
(require 'elark-ai-skills)     ; build-agent-prompt, build-synthesis-prompt
(require 'elark-ai-llm)        ; call-llm, call-llm-stream
(require 'elark-ai-runner)     ; elark-ai-step-timeout
(require 'elark-core)          ; elark--run-command
(require 'elark-ai-ui)         ; elark-ai-ui-append-fragment

;;;; Customization

(defcustom elark-ai-strategy 'agent
  "How a turn is executed.  Defaults to `agent'.
- `agent' — run an iterative ReAct loop, one action at a time, until the
            model produces a final answer (see `elark-ai-agent--run').
- `plan'  — ask the LLM for a whole plan upfront, review, execute, then
            synthesize a final answer (see `elark-ai-runner')."
  :type '(choice (const :tag "Agentic loop" agent)
                 (const :tag "Upfront plan" plan))
  :group 'elark-ai)

(defcustom elark-ai-agent-max-steps 20
  "Maximum command/parse iterations before the agent loop is forced to finish.
Bounds runaway loops and total LLM round-trips.  On hitting the cap the
loop makes one final LLM call to write the user-facing answer."
  :type 'integer
  :group 'elark-ai)

(defcustom elark-ai-agent-confirm-writes t
  "When non-nil, the agent loop prompts before each side-effecting command.
The prompt shows the exact resolved command.  Recommended: the agent's
command arguments are model-generated, so a human gate catches a bad
write before it happens.  Commands matching
`elark-ai-auto-execute-commands' (e.g. \"docs +create\") run without
the prompt even when this is non-nil."
  :type 'boolean
  :group 'elark-ai)

(defcustom elark-ai-agent-observation-truncate-chars 1500
  "Maximum characters of a single command observation fed back to the model.
Large CLI results are clipped so the transcript, which is re-sent every
iteration, does not blow up the context window."
  :type 'integer
  :group 'elark-ai)

(defconst elark-ai-agent--content-flags
  '("--content" "--markdown" "--body" "--text" "--message")
  "Argument flags whose value is model-generated content.
Used both to guard against a side-effecting command that writes empty
content (the empty-document failure class) and to identify which
argument values should be clipped to a preview in user-facing UI
\(confirm prompt, tool-call card, progress log) via
`elark-ai-agent-abbreviate-cmd'.")

(defcustom elark-ai-agent-preview-chars 60
  "Maximum chars of a content-flag value shown in user-facing previews.
Side-effecting commands generated by the agent (for example
`docs +create --content <body>') often carry tens of KB of inline
content.  In the minibuffer confirm prompt, the tool-call card, and
the progress log, that value is clipped to this many chars of its
first line plus a `[N chars]' tail so the buffer doesn't drown in a
doc body.  The transcript fed back to the LLM still receives the
unabbreviated command — this only affects display."
  :type 'integer
  :group 'elark-ai)

(defun elark-ai-agent--preview-string (s)
  "Return a one-line, `elark-ai-agent-preview-chars'-bounded preview of S.
Multi-line or over-budget strings get a `… [N chars]' tail so the
original length stays visible without inlining the body.

A clipped result carries a `elark-ai-preview' text property so the
tool-call card formatter can wrap it in display quotes instead of
running it through shell-escaping (which would mangle the ellipsis
and the bracketed tail)."
  (if (not (stringp s))
      s
    (let* ((nl (string-search "\n" s))
           (head (if nl (substring s 0 nl) s))
           (clipped (truncate-string-to-width
                     head elark-ai-agent-preview-chars nil nil "…")))
      (if (and (null nl) (= (length clipped) (length s)))
          s
        (propertize (format "%s [%d chars]" clipped (length s))
                    'elark-ai-preview t)))))

(defun elark-ai-agent-abbreviate-cmd (cmd)
  "Return a copy of CMD with content-flag values clipped to a preview.
A value immediately following any flag in `elark-ai-agent--content-flags'
is replaced by `elark-ai-agent--preview-string' applied to it; every
other element passes through verbatim.  Pure presentation — call it
when rendering CMD into the minibuffer / tool-call card / log, never
when feeding CMD back into the LLM transcript or running it."
  (let (out (rest cmd))
    (while rest
      (let ((arg (car rest)))
        (push arg out)
        (if (and (member arg elark-ai-agent--content-flags)
                 (cdr rest)
                 (stringp (cadr rest)))
            (progn
              (push (elark-ai-agent--preview-string (cadr rest)) out)
              (setq rest (cddr rest)))
          (setq rest (cdr rest)))))
    (nreverse out)))

;;;; Command coercion / validation

(defun elark-ai-agent--command-list (cmd)
  "Coerce a parsed CMD value into a list of argument strings, or nil."
  (cond ((null cmd) nil)
        ((vectorp cmd) (append cmd nil))
        ((listp cmd) cmd)
        ((stringp cmd) (list cmd))
        (t nil)))

(defun elark-ai-agent--empty-content-p (cmd)
  "Return non-nil when CMD passes a content flag with an empty value.
See `elark-ai-agent--content-flags'."
  (let ((tail cmd) (empty nil))
    (while (and tail (not empty))
      (when (and (member (car tail) elark-ai-agent--content-flags)
                 (cdr tail)
                 (or (not (stringp (cadr tail)))
                     (string-empty-p (string-trim (cadr tail)))))
        (setq empty t))
      (setq tail (cdr tail)))
    empty))

;;;; Observations and transcript

(defun elark-ai-agent--format-observation (result)
  "Render a lark-cli RESULT (parsed JSON alist, string, or error) for the model.
Truncated to `elark-ai-agent-observation-truncate-chars'."
  (let ((text (cond ((null result) "(no data)")
                    ((stringp result) result)
                    (t (json-encode result)))))
    (if (> (length text) elark-ai-agent-observation-truncate-chars)
        (concat (substring text 0 elark-ai-agent-observation-truncate-chars)
                "\n…[truncated]")
      text)))

(defun elark-ai-agent--record (session action observation)
  "Append (ACTION . OBSERVATION) to SESSION's transcript and log it."
  (setf (elark-ai-session-agent-steps session)
        (append (elark-ai-session-agent-steps session)
                (list (cons action observation))))
  (elark-ai--ui :progress-log
    "  → %s"
    (truncate-string-to-width
     (replace-regexp-in-string "[ \t\n]+" " " (string-trim observation)) 200)))

(defun elark-ai-agent--render-transcript (transcript)
  "Render TRANSCRIPT (list of (ACTION . OBSERVATION)) as prompt text."
  (let ((n 0))
    (mapconcat
     (lambda (entry)
       (let* ((action (car entry))
              (obs (cdr entry))
              (thought (alist-get 'thought action))
              (cmd (elark-ai-agent--command-list (alist-get 'command action))))
         (setq n (1+ n))
         (concat
          (format "### Action %d\n" n)
          (when thought (format "Thought: %s\n" thought))
          (when cmd (format "Command: lark-cli %s\n" (string-join cmd " ")))
          (format "Observation:\n%s\n" obs))))
     transcript "\n")))

(defun elark-ai-agent--build-user-message (prompt context history transcript)
  "Build the per-iteration user message.
Combines the base request (PROMPT + CONTEXT + HISTORY) with the running
TRANSCRIPT of actions taken so far."
  (concat
   (elark-ai--build-user-message prompt context history)
   (when transcript
     (concat "\n\n## Actions taken so far\n"
             (elark-ai-agent--render-transcript transcript)
             "\n\nDecide the next action: a \"command\" to run, or"
             " \"final\" with your answer."))))

;;;; Parsing

(defun elark-ai-agent--parse-action (text)
  "Parse one agent action object from TEXT, or nil when invalid.
A valid action is a JSON object whose `action' is \"command\" or
\"final\"."
  (let ((data (elark-ai--extract-json text)))
    (when (and (listp data)
               (member (alist-get 'action data) '("command" "final")))
      data)))

;;;; Loop

(defun elark-ai-agent--run (prompt context history session skill-names)
  "Entry point for the agentic loop strategy.
PROMPT, CONTEXT, HISTORY and SESSION carry the turn state; SKILL-NAMES
selects the skills whose docs are included in the system prompt."
  (setf (elark-ai-session-skills session) skill-names
        (elark-ai-session-agent-steps session) nil
        (elark-ai-session-phase session) 'executing
        (elark-ai-session-system-prompt session)
        (elark-ai-skills-build-agent-prompt skill-names))
  (elark-ai--ui :progress-log "Agent loop started (max %d steps)."
                elark-ai-agent-max-steps)
  (elark-ai-agent--step prompt context history session 0))

(defun elark-ai-agent--step (prompt context history session iter)
  "Run iteration ITER: ask the model for the next action, then dispatch it.
PROMPT, CONTEXT, HISTORY and SESSION are the turn's loop state."
  (cond
   ;; Aborted/cancelled between hops — stop quietly.
   ((not (eq (elark-ai-session-phase session) 'executing)) nil)
   ;; Step cap — force a final answer instead of looping forever.
   ((>= iter elark-ai-agent-max-steps)
    (elark-ai--ui :progress-log "Reached step cap (%d); writing final answer."
                  elark-ai-agent-max-steps)
    (elark-ai-agent--force-final prompt context history session))
   (t
    (let ((system (elark-ai-session-system-prompt session))
          (user (elark-ai-agent--build-user-message
                 prompt context history
                 (elark-ai-session-agent-steps session))))
      (elark-ai--ui :progress-log "← LLM (agent step %d)…" (1+ iter))
      (elark-ai--call-llm-stream
       system user
       (lambda (response)
         (elark-ai-agent--handle-response
          response prompt context history session iter))
       ;; Preview a rolling tail of the streamed action under "Waiting
       ;; for LLM response…" so each step visibly progresses.
       (elark-ai--ui :stream-preview-handler))))))

(defun elark-ai-agent--handle-response (response prompt context history session iter)
  "Dispatch the model's RESPONSE for iteration ITER.
PROMPT, CONTEXT, HISTORY and SESSION are the turn's loop state.
The \"Waiting…/stream tail\" preview is left in place: the next step's
stream overwrites it, and the loop's terminal `elark-ai-agent--finish' /
`elark-ai-agent--force-final' clear it.  Clearing it here (mid-loop)
would empty the plan fragment and lose its anchor, so a later preview
update would create a duplicate."
  (let ((action (elark-ai-agent--parse-action response)))
    (pcase (and action (alist-get 'action action))
      ("final"
       (elark-ai-agent--finish session (or (alist-get 'answer action) "")))
      ("command"
       (elark-ai-agent--dispatch-command
        action prompt context history session iter))
      (_
       ;; Unparseable / unknown — feed an error observation so the model
       ;; can self-correct on the next turn (bounded by the step cap).
       (elark-ai-agent--record
        session
        (list (cons 'action "invalid"))
        (concat "ERROR: your reply was not a single JSON action object with"
                " an \"action\" of \"command\" or \"final\". Reply with exactly"
                " one such object and nothing else."))
       (elark-ai-agent--step prompt context history session (1+ iter))))))

(defun elark-ai-agent--dispatch-command (action prompt context history session iter)
  "Validate and run the \"command\" ACTION, then continue the loop.
PROMPT, CONTEXT, HISTORY, SESSION and ITER are the loop state.
Renders a tool-call card per dispatched command — inserted in the
running state before the CLI fires, then updated with the terminal
status (`done', `error', or `skipped') so the user has a visible,
collapsible record of each action."
  (let* ((cmd (elark-ai-agent--command-list (alist-get 'command action)))
         (side-effect (eq (alist-get 'side_effect action) t))
         (advance (lambda (status obs)
                    (when cmd
                      (elark-ai--ui :render-tool-call iter cmd status))
                    (elark-ai-agent--record session action obs)
                    (elark-ai-agent--step prompt context history session (1+ iter)))))
    (cond
     ((null cmd)
      (funcall advance 'error
               "ERROR: \"command\" must be a non-empty array of lark-cli arguments."))
     ((and side-effect (elark-ai-agent--empty-content-p cmd))
      (funcall advance 'error
               (concat "ERROR: this command writes content but the content"
                       " argument is empty. Provide the full content inline.")))
     ((and side-effect elark-ai-agent-confirm-writes
           ;; Whitelisted writes (e.g. "docs +create") skip the prompt.
           (not (elark-ai--command-auto-p cmd))
           (not (yes-or-no-p
                 (format "Agent: run lark-cli %s? "
                         (string-join
                          (elark-ai-agent-abbreviate-cmd cmd) " ")))))
      (funcall advance 'skipped "(skipped by user)"))
     (t
      ;; Both the progress-log line and the tool-call card use the
      ;; abbreviated form so a multi-KB --content body doesn't drown
      ;; the visible surfaces (it still goes verbatim to the CLI).
      (elark-ai--ui :progress-log
        "Agent: lark-cli %s"
        (string-join (elark-ai-agent-abbreviate-cmd cmd) " "))
      ;; Show the card in `running' state before dispatch so the user
      ;; sees the action immediately, even if the CLI takes seconds.
      (elark-ai--ui :render-tool-call iter cmd 'running)
      (elark-ai-agent--run-cli cmd advance)))))

(defun elark-ai-agent--run-cli (cmd done-fn)
  "Run lark-cli CMD, calling DONE-FN with (STATUS OBSERVATION).
STATUS is `done' on success, `error' on a non-zero exit / timeout —
passed through so the tool-call card can mark each step accurately."
  (elark--run-command
   cmd
   (lambda (result)
     (funcall done-fn 'done (elark-ai-agent--format-observation result)))
   nil
   :no-error t
   :timeout elark-ai-step-timeout
   :on-error
   (lambda (exit-code msg)
     (funcall done-fn 'error
              (elark-ai-agent--format-observation
               (list (cons 'error (if (and msg (not (string-empty-p msg)))
                                      msg "command failed"))
                     (cons 'exit_code exit-code)))))))

(defun elark-ai-agent--finish (session answer)
  "End SESSION's loop and present ANSWER to the user."
  (setf (elark-ai-session-phase session) 'done)
  (elark-ai--ui :clear-waiting)
  (elark-ai--ui :progress-log "Agent loop complete.")
  (elark-ai--ui :present answer))

(defun elark-ai-agent--force-final (prompt context history session)
  "Make a final, non-looping LLM call to answer after the step cap is hit.
PROMPT, CONTEXT, HISTORY and SESSION are the turn's loop state."
  (let ((system (elark-ai-skills-build-synthesis-prompt
                 (elark-ai-session-skills session)))
        (user (concat
               (elark-ai-agent--build-user-message
                prompt context history
                (elark-ai-session-agent-steps session))
               "\n\nYou have reached the action limit. Write the final answer"
               " for the user based on what you accomplished above."
               " Markdown prose, not JSON.")))
    (elark-ai--call-llm
     system user
     (lambda (text) (elark-ai-agent--finish session text)))))

(provide 'elark-ai-agent)
;;; elark-ai-agent.el ends here
